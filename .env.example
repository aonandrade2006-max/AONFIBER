# =====================================================================
# AON FIBER – environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =====================================================================

# --- Supabase (Dashboard → Project Settings → API) -------------------
VITE_SUPABASE_URL=https://ecbpasmtolsgecihwjmw.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://ecbpasmtolsgecihwjmw.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security – never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- API server -------------------------------------------------------
PORT=8787
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Customer one-time codes -----------------------------------------
# Long random string used to hash verification codes.
OTP_PEPPER=change-me-to-a-long-random-string
# true = return the code to the login screen when no email/SMS provider is
# configured (local development only). Always false in production.
OTP_DEV_MODE=true

# --- Optional external notifications ---------------------------------
# Any HTTP endpoint that accepts JSON { channel, to, subject, body }.
# Leave blank to use in-app notifications only (the UI says so explicitly).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# --- Employee presence -----------------------------------------------
# Employees are offline after this much inactivity (milliseconds).
PRESENCE_TIMEOUT_MS=120000
